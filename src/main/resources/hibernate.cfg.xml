<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "https://hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>

        <!-- Database Connection Settings -->
        <property name="hibernate.connection.driver_class">com.mysql.cj.jdbc.Driver</property>
        <!-- Això ho heu de canviar per les vostres dades -->
        <property name="hibernate.connection.url">jdbc:mysql://localhost:3306/catan?createDatabaseIfNotExist=true</property>
        <property name="hibernate.connection.username">root</property>
        <property name="hibernate.connection.password">super3</property>

        <!-- Aquesta és important. Valors: none | validate | update | create | create-drop
             Mentre fem proves, "create" esborra i torna a crear les taules a cada execució:
             així el programa es pot executar tantes vegades com vulguem sense errors de clau duplicada.
             Quan el model sigui estable (i a la pràctica), "update". -->
        <property name="hibernate.hbm2ddl.auto">create</property>

        <!-- Això ens permet xafardejar l'SQL que genera Hibernate. Opcional -->
        <property name="hibernate.show_sql">true</property>
        <!-- Això formata les sentències SQL -->
        <property name="hibernate.format_sql">true</property>
        <!-- Això mostra les sentències SQL en un altre color a la consola -->
        <property name="hibernate.highlight_sql">true</property>
        <!-- Això afegeix comentaris a les sentències
        <property name="hibernate.use_sql_comments">true</property>
        -->


        <mapping class="org.example.relationships.classes.Partida"/>
        <mapping class="org.example.relationships.classes.Jugador"/>
        <mapping class="org.example.relationships.classes.RecursJugador"/>
        <mapping class="org.example.relationships.classes.CartaDesenvolupament"/>
        <mapping class="org.example.relationships.classes.Hexagon"/>
        <mapping class="org.example.relationships.classes.Vertex"/>
        <mapping class="org.example.relationships.classes.HexagonVertex"/>
        <mapping class="org.example.relationships.classes.Aresta"/>
        <mapping class="org.example.relationships.classes.Construccio"/>
        <mapping class="org.example.relationships.classes.Assentament"/>
        <mapping class="org.example.relationships.classes.Poblat"/>
        <mapping class="org.example.relationships.classes.Ciutat"/>
        <mapping class="org.example.relationships.classes.Carretera"/>

    </session-factory>
</hibernate-configuration>

